<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ECULostAndFound.App.BrowsePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ECULostAndFound.App.ViewModels"
    xmlns:models="clr-namespace:ECULostAndFound.App.Models"
    x:DataType="vm:BrowseViewModel"
    Title="Find items"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#FAF8FC">

    <Grid Padding="18,16"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          RowSpacing="14">

        <Border Grid.Row="0"
                Padding="18"
                BackgroundColor="{StaticResource Primary}"
                Stroke="{StaticResource Primary}"
                StrokeShape="RoundRectangle 20">
            <VerticalStackLayout Spacing="6">
                <Label Text="ECU LOST &amp; FOUND"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#E9DDF2" />
                <Label Text="Find items on campus"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="Browse items reported by the campus community."
                       FontSize="14"
                       TextColor="White" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                Padding="4,0"
                BackgroundColor="White"
                Stroke="#E8E1ED"
                StrokeShape="RoundRectangle 14">
            <SearchBar Placeholder="Search by item, category, or location"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       BackgroundColor="Transparent"
                       CancelButtonColor="{StaticResource Primary}" />
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        SelectionMode="Single"
                        ItemsLayout="HorizontalList"
                        HeightRequest="44"
                        HorizontalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Margin="0,0,8,0"
                            Padding="14,8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#F0ECF4" />
                                        <Setter Property="Stroke" Value="#F0ECF4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#FFF2C2" />
                                        <Setter Property="Stroke" Value="{StaticResource Secondary}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Label Text="{Binding .}"
                               FontSize="13"
                               TextColor="#392B43"
                               VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              VerticalOptions="Center">
            <Label Text="Recently reported"
                   FontSize="19"
                   FontAttributes="Bold"
                   TextColor="#271D2E" />
            <Label Grid.Column="1"
                   Text="{Binding FilteredItems.Count, StringFormat='{0} items'}"
                   FontSize="13"
                   TextColor="#766B7D"
                   VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="4">
            <CollectionView ItemsSource="{Binding FilteredItems}"
                            IsVisible="{Binding IsNotLoading}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="No items to show"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="#392B43" />
                        <Label Text="Try a different search or check back later."
                               HorizontalTextAlignment="Center"
                               TextColor="#766B7D" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LostAndFoundItem">
                        <Border Padding="12"
                                BackgroundColor="White"
                                Stroke="#E8E1ED"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="8">
                                <Image Source="{Binding PhotoImageSource}"
                                       IsVisible="{Binding HasPhoto}"
                                       HeightRequest="100"
                                       Aspect="AspectFill" />
                                <Border Padding="8,4"
                                        HorizontalOptions="Start"
                                        BackgroundColor="#F0E8F6"
                                        Stroke="#F0E8F6"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="{Binding Status}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </Border>

                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#271D2E"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="#766B7D"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Category}"
                                       FontSize="12"
                                       TextColor="{StaticResource Primary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Category}"
                                                     Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Category}"
                                                     Value="">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="{Binding Location, StringFormat='Location: {0}'}"
                                       FontSize="12"
                                       TextColor="#51475A"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding CollectionLocation, StringFormat='Collect from: {0}'}"
                                       IsVisible="{Binding HasCollectionLocation}"
                                       FontSize="12"
                                       TextColor="#51475A"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding CollectionDetails, StringFormat='Desk/office: {0}'}"
                                       IsVisible="{Binding HasCollectionDetails}"
                                       FontSize="12"
                                       TextColor="#51475A"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding DateFound, StringFormat='Found {0:MMM d, yyyy}'}"
                                       FontSize="11"
                                       TextColor="#8A8090" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding IsLoading}"
                                 Spacing="10"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="{StaticResource Primary}" />
                <Label Text="Loading saved items..."
                       TextColor="#766B7D" />
            </VerticalStackLayout>

            <Label Text="{Binding LoadError}"
                   IsVisible="{Binding HasLoadError}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="#8B1E2D" />
        </Grid>
    </Grid>
</ContentPage>
