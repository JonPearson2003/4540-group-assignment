<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="ECULostAndFound.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="{Binding Title}"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Campus Lost &amp; Found"
                FontSize="20"
                HorizontalOptions="Center" />

            <Label 
                Text="{Binding StatusMessage}"
                FontSize="16"
                HorizontalOptions="Center" />

            <Label
                Text="Report and find lost items, when while offline."
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"  />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>